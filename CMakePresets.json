{
  "version": 8,
  "configurePresets": [
    {
      "name": "base",
      "displayName": "Base configuration for the rest of presets",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "develop",
      "displayName": "Develop and Debug preset",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release mode with optimizations preset",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "develop", "configurePreset": "develop", "jobs": 0 },
    { "name": "release", "configurePreset": "release", "jobs": 0 }
  ]
}
